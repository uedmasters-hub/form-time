# Supabase project for syncing calendar items. The publishable key is meant
# for client apps; rows are protected by row-level security
# (supabase/migrations). Copy to .env to override the defaults in
# src/features/sync/config.ts.
EXPO_PUBLIC_SUPABASE_URL=https://drrhnblmbdjnumgymzpj.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_oP2MEQk-RjcOzby-s2n9lA_J98dYa4p

# Google Calendar two-way sync (web). Create an OAuth client ID of type
# "Web application" in Google Cloud (APIs & Services → Credentials), enable
# the Google Calendar API, and add the address the app runs at (for example
# http://localhost:8081) to "Authorized JavaScript origins". The client ID is
# public. Without it, Google Calendar stays off and Settings shows no option.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
